# Build stage
FROM node:24-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Remove electron-specific dependencies and overrides for web build using node
RUN node -e "\
const fs = require('fs'); \
const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8')); \
delete pkg.devDependencies?.electron; \
delete pkg.devDependencies?.['electron-builder']; \
delete pkg.devDependencies?.['electron-vite']; \
delete pkg.devDependencies?.['@electron/rebuild']; \
delete pkg.devDependencies?.['@electron-toolkit/preload']; \
delete pkg.devDependencies?.['@electron-toolkit/utils']; \
delete pkg.dependencies?.['@lydell/node-pty']; \
delete pkg.overrides; \
fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2));"

# Install dependencies (use npm install since lock file may be out of sync)
RUN npm install --ignore-scripts

# Copy source code
COPY . .

# Build the web version
RUN npm run build:web

# Production stage - serve static files with nginx
FROM nginx:alpine

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder stage
COPY --from=builder /app/dist-web /usr/share/nginx/html

# Copy env-config.js template for runtime substitution
COPY public/env-config.js /usr/share/nginx/html/env-config.js

# Copy entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Expose port 80
EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]